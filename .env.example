# Model. Either a holder / Build Week key, or leave empty and let the wallet derive one.
ORBIO_API_KEY=
ORBIO_BASE_URL=https://api.orbio.so/api/v1
ORBIO_MODEL=anthropic/claude-sonnet-5
# Used when the primary model has no provider serving on Orbio
ORBIO_MODEL_FALLBACK=anthropic/claude-sonnet-4.5
# Money. The agent wallet on Robinhood Chain (4663). Needs USDG for the round and a little ETH for gas.
# Without it the money layer runs as a stub that logs what it would do.
WALLET_PRIVATE_KEY=
RPC_URL=https://rpc.mainnet.chain.robinhood.com
ORBIO_KEY_EPOCH=0
PORT=3010
# 1 = Pay now $0, skip buyAndActivate; round still goes live on your Orbio credits
FUND_TESTING=1
# Bearer token for GET /api/health (defaults to "local")
HEALTH_TOKEN=
# 1 = rounds spend from the product key instead of the round wallet key (testing)
TEST_ON_PREP_KEY=
# Optional: a finished round linked from the landing page, and round ids labelled as demos
DEMO_URL=
DEMO_ROUND_IDS=
