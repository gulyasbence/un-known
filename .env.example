# Model. Either a holder / Build Week key, or leave empty and let the wallet derive one.
ORBIO_API_KEY=
ORBIO_BASE_URL=https://api.orbio.so/api/v1
ORBIO_MODEL=anthropic/claude-sonnet-4.5
# Money. The agent wallet on Robinhood Chain (4663). Needs USDG for the round and a little ETH for gas.
# Without it the money layer runs as a stub that logs what it would do.
WALLET_PRIVATE_KEY=
RPC_URL=https://rpc.mainnet.chain.robinhood.com
ORBIO_KEY_EPOCH=0
PORT=3010
